# Database (e.g. Neon PostgreSQL, Supabase, Vercel Postgres)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth Secret (generate a 32+ char random string or use openssl rand -base64 32)
BETTER_AUTH_SECRET="duseat-admin-production-secret-key-32chars-min"

# Production App URL (e.g. https://your-app.vercel.app)
BETTER_AUTH_URL="https://your-app.vercel.app"
